# Dork Atlas Ultimate — Environment Configuration
# Copy this file to .env and adjust variables as needed.

# Application
DORK_ATLAS_APP_NAME="Dork Atlas Ultimate"
DORK_ATLAS_VERSION="0.1.0"
DORK_ATLAS_ENVIRONMENT=development
DORK_ATLAS_LOG_LEVEL=INFO

# Database
# Default: local SQLite with aiosqlite in data/dork_atlas.db
DORK_ATLAS_DATABASE_URL=sqlite+aiosqlite:///data/dork_atlas.db
# For production PostgreSQL:
# DORK_ATLAS_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dork_atlas

# Security
# Leave empty for single-user local development without API key enforcement.
# In multi-user or networked setups, set a secret key required in X-API-Key header.
DORK_ATLAS_API_KEY=
DORK_ATLAS_RATE_LIMIT_REQUESTS=120
DORK_ATLAS_RATE_LIMIT_WINDOW_SECONDS=60

# Search Providers (Backend-only; never exposed to frontend bundles)
# SearXNG instance endpoint (self-hosted or docker container)
DORK_ATLAS_SEARXNG_URL=http://localhost:8080
# Optional Brave Search API Key (https://brave.com/search/api/)
DORK_ATLAS_BRAVE_API_KEY=

# Search Engine Defaults
DORK_ATLAS_DEFAULT_PROVIDER=searxng
DORK_ATLAS_DEFAULT_RESULTS_PER_PAGE=20
DORK_ATLAS_MAX_RESULTS_PER_PAGE=50
DORK_ATLAS_PROVIDER_REQUEST_TIMEOUT_SECONDS=12.0
DORK_ATLAS_SEARCH_CACHE_TTL_SECONDS=300
DORK_ATLAS_MAX_CONCURRENT_PROVIDERS=4

# History Retention
DORK_ATLAS_HISTORY_RETENTION_DAYS=180
DORK_ATLAS_HISTORY_MAX_ENTRIES=5000
